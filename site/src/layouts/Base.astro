---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'A genealogy of machine-learning models: which model descends from which, and the evidence for every claim.' } = Astro.props;
const full = title === 'Stemma Machinarum' ? title : `${title} · Stemma Machinarum`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stemma Machinarum" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Stemma Machinarum: part of the LLaMA family drawn as a manuscript stemma, with closed models, datasets and open-weight models." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">Stemma Machinarum</a>
        <nav>
          <a href="/about/">About</a>
          <a href="/graph/">Stemma</a>
          <a href="/records/">Records</a>
          <a href="/notebook/">Notebook</a>
          <a href="/method/">Method</a>
        </nav>
      </div>
    </header>
    <main><div class="wrap"><slot /></div></main>
    <footer class="site">
      <div class="wrap">
        <a href="/glossary/">Glossary</a>
        <a href="/review/">Review procedure</a>
        <a href="/disputes/">Disputes policy</a>
        <a href="/data/edges/edges.jsonl">Raw data</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="https://github.com/wilsonpruitt/stemma-machinarum">Source</a>
        <span>Data and schema CC BY 4.0 · code MIT</span>
      </div>
    </footer>
  </body>
</html>
