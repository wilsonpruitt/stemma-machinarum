{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemma.network/schema/edge.schema.json",
  "title": "Stemma Lineage Edge",
  "description": "One line in data/edges/edges.jsonl. child/parent are model or dataset ids; scripts/validate.py enforces which relation may join which kinds.",
  "type": "object",
  "properties": {
    "child": { "type": "string" },
    "parent": { "type": "string" },
    "relation": {
      "enum": [
        "fine_tuned_from",
        "distilled_from_outputs",
        "feedback_from",
        "merged_from",
        "quantized_from",
        "adapter_on",
        "same_architecture_retrained",
        "design_follows",
        "successor_in_series",
        "trained_on"
      ]
    },
    "evidence": {
      "enum": [
        "declared",
        "declared_by_uploader",
        "inferred_weights",
        "inferred_behavior",
        "alleged"
      ]
    },
    "source": { "type": "string", "format": "uri" },
    "note": { "type": "string" }
  },
  "required": ["child", "parent", "relation", "evidence", "source"],
  "additionalProperties": false
}
