{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemma.network/schema/technique.schema.json",
  "title": "Stemma Technique Record",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": { "type": "string" },
    "first_appearance": {
      "type": "object",
      "properties": {
        "value": { "type": "string" },
        "source": { "type": "string", "format": "uri" }
      },
      "required": ["value", "source"],
      "additionalProperties": false
    },
    "description": { "type": "string" },
    "used_by": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model_id": { "type": "string" },
          "source": { "type": "string", "format": "uri" }
        },
        "required": ["model_id", "source"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "name", "first_appearance", "description"],
  "additionalProperties": false
}
